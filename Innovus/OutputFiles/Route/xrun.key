database -open waves -into waves.shm -default
probe -create -shm testbench.stack.clk testbench.stack.reset testbench.stack.push testbench.stack.pop testbench.stack.data_in testbench.stack.data_out testbench.stack.test_mode testbench.stack.scan_in testbench.stack.scan_out testbench.stack.scan_reg_data_out testbench.stack.sp
run
stop -create -object testbench.stack.sp[0] -name testbench.stack.sp[0]
stop -create -object testbench.stack.sp[1] -name testbench.stack.sp[1]
stop -create -object testbench.stack.sp[2] -name testbench.stack.sp[2]
stop -create -object testbench.stack.sp[3] -name testbench.stack.sp[3]
exit
