database -open waves -into waves.shm -default
probe -create -shm testbench.stack.clk testbench.stack.data_in testbench.stack.data_out testbench.stack.full testbench.stack.memory testbench.stack.null testbench.stack.pop testbench.stack.push testbench.stack.reset testbench.stack.scan_in testbench.stack.scan_out testbench.stack.scan_reg_data_out testbench.stack.scan_reg_sp testbench.stack.sp testbench.stack.test_mode
run
scope -set testbench.stack
exit
